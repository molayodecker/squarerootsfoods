# Copy to .env. The real file stays on the machine that runs the API.

# Production requires DATABASE_URL and SECRET_KEY_BASE.
# Development uses the OS user, localhost, port 5432, and database vader_dev when these are unset.
# DATABASE_URL=ecto://USER:PASSWORD@HOST/DATABASE
# SECRET_KEY_BASE=
# PHX_HOST=example.com
# PHX_SERVER=true

# PGHOST=localhost
# PGPORT=5432
# PGUSER=
# PGPASSWORD=
# PGDATABASE=vader_dev
# PORT=8080
# POOL_SIZE=10

# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=
# PUBLIC_BASE_URL=http://127.0.0.1:8080
# ADMIN_EMAIL=operator@localhost
# ADMIN_PASSWORD=change-me

# ECTO_IPV6=true
# DNS_CLUSTER_QUERY=
